{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dash-idiomas-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/matricula/*", "/pagamento/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "dash-idiomas", "database_id": "PREENCHER_APOS_CRIAR_O_BANCO", "migrations_dir": "migrations" }
  ],
  "vars": {
    "SITE_URL": "http://localhost:8787",
    "ASAAS_BASE_URL": "https://api-sandbox.asaas.com",
    "TOKEN_TTL_HOURS": "168"
  }
  // Segredos (configurar no painel da Cloudflare, nunca no código):
  // ASAAS_API_KEY, ASAAS_WEBHOOK_TOKEN, SHEETS_WEBAPP_URL, SHEETS_SECRET
}
