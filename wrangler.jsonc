{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dash-idiomas-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  // Logs do Worker (Cloudflare > Workers > dash-idiomas-site > Observability)
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/matricula/*", "/pagamento/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "dash-idiomas", "database_id": "bc71f3b7-663d-4158-8f7d-140c44e83660", "migrations_dir": "migrations" }
  ],
  "vars": {
    "SITE_URL": "https://dash-idiomas-site.dashidiomas.workers.dev",
    "ASAAS_BASE_URL": "https://api-sandbox.asaas.com",
    "TOKEN_TTL_HOURS": "168"
  }
  // Segredos (configurar no painel da Cloudflare, nunca no código):
  // ASAAS_API_KEY, ASAAS_WEBHOOK_TOKEN, SHEETS_WEBAPP_URL, SHEETS_SECRET
}
